{
  "name": "slice-tennis",
  "version": "1.0.0",
  "private": true,
  "description": "Slice by STA — courtside home for a day of tennis.",
  "type": "module",
  "engines": {
    "node": "22.x || 24.x"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server.js",
    "seed": "node --disable-warning=ExperimentalWarning scripts/seed.js --reset",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.js\"",
    "build": "node scripts/build.js",
    "deploy": "vercel --prod"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "pdfkit": "^0.20.2"
  }
}
